    "magpie-models-price": "./index.js"
  },
  "scripts": {
    "start": "node index.js ui",
    "list": "node index.js list",
    "sync": "node index.js sync",
    "sync:dry": "node index.js sync --dry-run",
    "test": "node check.js"
  },
  "keywords": [
    "magpie",
    "models.dev",
    "pricing",
    "llm-costs"
  ],
  "author": "zrtzrt <519539110@qq.com>",
